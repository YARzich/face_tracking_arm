"""Start the project's Docker tools using only the host's standard Python library."""

from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent / 'docker'))
from host import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
