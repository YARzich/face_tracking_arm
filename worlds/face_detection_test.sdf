<?xml version="1.0"?>
<sdf version="1.9">
  <world name="face_detection_test">
    <physics name="default" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.75 0.78 0.82 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 -3 5 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0.5 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground">
        <visual name="ground">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://person_standing</uri>
      <name>person</name>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <model name="face_test_camera">
      <static>true</static>
      <pose>0 -1.2 1.65 0 0 1.57079632679</pose>
      <link name="camera_link">
        <visual name="body">
          <pose>-0.06 0 0 0 0 0</pose>
          <geometry><box><size>0.1 0.12 0.08</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>
        <sensor name="camera" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/face_test/image_raw</topic>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>10</far></clip>
            <camera_info_topic>/face_test/camera_info</camera_info_topic>
            <optical_frame_id>face_test_camera_optical_frame</optical_frame_id>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
