<?xml version="1.0" encoding="utf-8"?>
<!-- MoveIt semantics for Servo only; no planning pipeline is configured. -->
<robot name="lite6">
  <group name="lite6_arm">
    <chain base_link="link_base" tip_link="monitor_control_frame"/>
  </group>

  <group_state name="rest" group="lite6_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.57754821"/>
    <joint name="joint3" value="0.15413313"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="-0.83912233"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Compact scan posture: camera points about 20 degrees above horizontal. -->
  <group_state name="search" group="lite6_arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.57754821"/>
    <joint name="joint3" value="0.15413313"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="-1.19"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- UFACTORY's adjacent/never-colliding pairs for the six-link arm. -->
  <disable_collisions link1="link_base" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link_base" link2="link2" reason="Never"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link3" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link4" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link5" reason="Never"/>
  <disable_collisions link1="link3" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>

  <!-- Only the directly mounted pair is disabled for the monitor. -->
  <disable_collisions link1="link6" link2="monitor_link" reason="Adjacent"/>
</robot>
