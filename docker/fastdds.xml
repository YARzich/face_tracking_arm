<?xml version="1.0" encoding="UTF-8" ?>
<!-- UDP also works with a camera driver outside the container's IPC namespace. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>container_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="container_default" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>container_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
