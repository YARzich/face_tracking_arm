@@ -0,0 +1,67 @@
+// Copyright 2026 YARzich
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+
+namespace face_tracking_arm
+{
+namespace hardware
+{
+
+struct PositionCommandValidation
+{
+  bool valid = false;
+  std::size_t joint_index = 0;
+};
+
+inline PositionCommandValidation validate_finite_position_command(
+  const double * requested, const float * wire, std::size_t count) noexcept
+{
+  if (requested == nullptr || wire == nullptr || count != 6) {
+    return {false, 0};
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    if (!std::isfinite(requested[i]) || !std::isfinite(wire[i])) {
+      return {false, i};
+    }
+  }
+  return {true, count};
+}
+
+inline bool position_command_allowed(
+  bool runtime_actions_enabled, bool limits_available,
+  bool finite_candidate_valid, bool bounded_candidate_valid) noexcept
+{
+  return finite_candidate_valid &&
+         (!runtime_actions_enabled || (limits_available && bounded_candidate_valid));
+}
+
+inline PositionCommandValidation validate_position_command(
+  const double * requested, const float * wire,
+  const double * minimum, const double * maximum,
+  const bool * limit_valid, std::size_t count) noexcept
+{
+  if (requested == nullptr || wire == nullptr || minimum == nullptr ||
+    maximum == nullptr || limit_valid == nullptr || count != 6)
+  {
+    return {false, 0};
+  }
+  for (std::size_t i = 0; i < count; ++i) {
+    const double wire_value = static_cast<double>(wire[i]);
+    if (!limit_valid[i] || !std::isfinite(minimum[i]) || !std::isfinite(maximum[i]) ||
+      minimum[i] >= maximum[i] || !std::isfinite(requested[i]) ||
+      !std::isfinite(wire[i]) || requested[i] < minimum[i] ||
+      requested[i] > maximum[i] || wire_value<minimum[i] ||
+      wire_value> maximum[i])
+    {
+      return {false, i};
+    }
+  }
+  return {true, count};
+}
+
+}  // namespace hardware
+}  // namespace face_tracking_arm
diff --git a/xarm_controller/include/xarm_controller/hardware_io_write_gate.hpp b/xarm_controller/include/xarm_controller/hardware_io_write_gate.hpp
new file mode 100644
index 0000000..07fa343
--- /dev/null
+++ b/xarm_controller/include/xarm_controller/hardware_io_write_gate.hpp
@@ -0,0 +1,75 @@
+// Copyright 2026 YARzich
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace face_tracking_arm
+{
+namespace hardware
+{
+
+// With the runtime policy armed, STOP owns the transition before a controller
+// reset/deactivation can start another SDK-side action.
+inline bool defer_controller_deactivation_until_stop(
+  bool runtime_actions_enabled, bool hardware_active) noexcept
+{
+  return runtime_actions_enabled && hardware_active;
+}
+
+inline bool refuse_activation_after_latched_fault(
+  bool runtime_actions_enabled, bool inhibit_latched, bool fault_latched) noexcept
+{
+  return runtime_actions_enabled && (inhibit_latched || fault_latched);
+}
+
+// Keep the status publisher alive for an active gated disconnect so the
+// monitor can record the latched failure; legacy mode retains process exit.
+inline bool should_shutdown_on_disconnected_read(
+  bool runtime_actions_enabled, bool read_still_in_active_epoch) noexcept
+{
+  return !runtime_actions_enabled || !read_still_in_active_epoch;
+}
+
+// One-shot admission gate: close is atomic, and try_enter never retries.
+class HardwareIoWriteGate
+{
+public:
+  bool try_enter() noexcept
+  {
+    auto state = state_.load(std::memory_order_acquire);
+    if ((state & kClosed) != 0 || (state & kCountMask) != 0) {return false;}
+    return state_.compare_exchange_strong(
+            state, state + 1, std::memory_order_acq_rel, std::memory_order_acquire);
+  }
+
+  void leave() noexcept
+  {
+    state_.fetch_sub(1, std::memory_order_release);
+  }
+
+  void close() noexcept
+  {
+    state_.fetch_or(kClosed, std::memory_order_acq_rel);
+  }
+
+  std::uint32_t in_flight() const noexcept
+  {
+    return state_.load(std::memory_order_acquire) & kCountMask;
+  }
+
+  bool closed() const noexcept
+  {
+    return (state_.load(std::memory_order_acquire) & kClosed) != 0;
+  }
+
+private:
+  static constexpr std::uint32_t kClosed = std::uint32_t{1} << 31;
+  static constexpr std::uint32_t kCountMask = kClosed - 1;
+  std::atomic<std::uint32_t> state_{0};
+};
+
+}  // namespace hardware
+}  // namespace face_tracking_arm
