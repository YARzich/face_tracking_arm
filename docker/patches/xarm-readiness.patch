+    void UFRobotSystemHardware::capture_first_fault(
+        uint8_t kind, int32_t code, uint64_t sequence,
+        uint64_t read_attempt_sequence, int64_t stamp_ns, uint64_t epoch,
+        const double * candidate_double, const float * candidate_float,
+        bool candidate_valid, uint8_t candidate_joint_index)
+    {
+        uint8_t expected = 0;
+        if (!first_fault_capture_state_.compare_exchange_strong(
+                expected, 1, std::memory_order_acq_rel, std::memory_order_acquire)) return;
+        first_fault_sequence_.store(sequence, std::memory_order_relaxed);
+        first_fault_kind_.store(kind, std::memory_order_relaxed);
+        first_fault_code_.store(code, std::memory_order_relaxed);
+        first_fault_read_attempt_sequence_.store(read_attempt_sequence, std::memory_order_relaxed);
+        first_fault_stamp_ns_.store(stamp_ns, std::memory_order_relaxed);
+        first_fault_epoch_.store(epoch, std::memory_order_relaxed);
+        first_fault_candidate_valid_.store(candidate_valid, std::memory_order_relaxed);
+        first_fault_candidate_joint_index_.store(candidate_joint_index, std::memory_order_relaxed);
+        if (candidate_double != nullptr && candidate_float != nullptr) {
+            for (size_t i = 0; i < 6; ++i) {
+                first_fault_candidate_double_[i].store(candidate_double[i], std::memory_order_relaxed);
+                first_fault_candidate_float_[i].store(candidate_float[i], std::memory_order_relaxed);
+            }
+        }
+        first_fault_capture_state_.store(2, std::memory_order_release);
+    }
+
+    bool UFRobotSystemHardware::latch_servoj_inhibit()
+    {
+        write_gate_.close();
+        auto current = inhibit_state_.load(std::memory_order_acquire);
+        if (current & 1U) return true;
+        inhibit_epoch_.store(hardware_epoch_.load(std::memory_order_acquire),
+                             std::memory_order_relaxed);
+        const auto next = ((current >> 1) + 1) << 1 | 1U;
+        if (inhibit_state_.compare_exchange_strong(
+                current, next, std::memory_order_acq_rel, std::memory_order_acquire)) {
+            return false;
+        }
+        return (current & 1U) != 0;
+    }
