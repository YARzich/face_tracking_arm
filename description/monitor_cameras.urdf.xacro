<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Gazebo camera axes: +X forward, +Y left, +Z up; ROS optical: right/down/forward. -->
  <xacro:macro name="monitor_rgb_sensor" params="name lateral frame topic info tx">
    <link name="${name}_frame"/>
    <joint name="${name}_mount" type="fixed">
      <parent link="monitor_camera_bar"/><child link="${name}_frame"/>
      <origin xyz="${camera_depth / 2 + .001} ${lateral} 0"/>
    </joint>
    <link name="${frame}"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_frame"/><child link="${frame}"/>
      <origin rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
    <gazebo reference="monitor_camera_bar">
      <sensor name="${name}" type="camera">
        <pose>${camera_depth / 2 + .001} ${lateral} 0 0 0 0</pose>
        <always_on>true</always_on><update_rate>${camera_rate}</update_rate>
        <topic>${topic}</topic>
        <camera>
          <horizontal_fov>${horizontal_fov}</horizontal_fov>
          <image><width>${image_width}</width><height>${image_height}</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20</far></clip>
          <camera_info_topic>${info}</camera_info_topic>
          <optical_frame_id>${frame}</optical_frame_id>
          <lens>
            <intrinsics>
              <fx>${camera_focal}</fx><fy>${camera_focal}</fy><cx>${image_width / 2}</cx><cy>${image_height / 2}</cy><s>0</s>
            </intrinsics>
            <projection>
              <p_fx>${camera_focal}</p_fx><p_fy>${camera_focal}</p_fy>
              <p_cx>${image_width / 2}</p_cx><p_cy>${image_height / 2}</p_cy><tx>${tx}</tx><ty>0</ty>
            </projection>
          </lens>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="monitor_cameras" params="mode baseline horizontal_fov:=1.433 image_width:=1280 image_height:=720
    camera_rate:=30 monitor_height:=0.224 camera_depth:=0.027 camera_height:=0.0265">
    <xacro:property name="camera_focal" value="${image_width / (2 * tan(horizontal_fov / 2))}"/>
    <xacro:property name="stereo" value="${mode == 'stereo'}"/>
    <xacro:property name="bar_width" value="${max(0.102, baseline + 0.028) if stereo else 0.102}"/>
    <xacro:property name="bar_mass" value="0.065"/>
    <link name="monitor_camera_bar">
      <inertial>
        <mass value="${bar_mass}"/>
        <inertia ixx="${bar_mass * (bar_width**2 + camera_height**2) / 12}" ixy="0" ixz="0"
          iyy="${bar_mass * (camera_depth**2 + camera_height**2) / 12}" iyz="0"
          izz="${bar_mass * (camera_depth**2 + bar_width**2) / 12}"/>
      </inertial>
      <visual>
        <geometry><box size="${camera_depth} ${bar_width} ${camera_height}"/></geometry>
        <material name="camera_dark"><color rgba="0.04 0.04 0.05 1"/></material>
      </visual>
      <collision><geometry><box size="${camera_depth} ${bar_width} ${camera_height}"/></geometry></collision>
      <visual name="left_lens">
        <origin xyz="${camera_depth / 2} ${baseline / 2 if stereo else 0} 0" rpy="0 ${pi / 2} 0"/>
        <geometry><cylinder radius="0.008" length="0.002"/></geometry>
        <material name="camera_glass"><color rgba="0.1 0.35 0.6 1"/></material>
      </visual>
      <xacro:if value="${stereo}">
        <visual name="right_lens">
          <origin xyz="${camera_depth / 2} ${-baseline / 2} 0" rpy="0 ${pi / 2} 0"/>
          <geometry><cylinder radius="0.008" length="0.002"/></geometry>
          <material name="camera_glass"/>
        </visual>
      </xacro:if>
    </link>
    <joint name="monitor_camera_mount" type="fixed">
      <parent link="monitor_link"/><child link="monitor_camera_bar"/>
      <origin xyz="0 0 ${monitor_height / 2 + camera_height / 2}"/>
    </joint>
    <xacro:monitor_rgb_sensor name="monitor_left_camera"
      lateral="${baseline / 2 if stereo else 0}" frame="face_test_camera_optical_frame"
      topic="/face_test/image_raw" info="/face_test/camera_info" tx="0"/>
    <xacro:if value="${stereo}">
      <xacro:monitor_rgb_sensor name="monitor_right_camera"
        lateral="${-baseline / 2}" frame="face_test_right_optical_frame"
        topic="/face_test/right/image_raw" info="/face_test/right/camera_info"
        tx="${-camera_focal * baseline}"/>
    </xacro:if>
  </xacro:macro>
</robot>
